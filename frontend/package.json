{
  "name": "datasecurity-workspace",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "scripts": {
    "format": "prettier --write src tests vite.config.ts",
    "format:check": "prettier --check src tests vite.config.ts",
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "tsc --noEmit && vite build",
