{
  "version": 1,
  "name": "真实题：Apache日志恢复与脱敏",
  "description": "广工2025网安卫士公开原附件；请先运行 python scripts/real_ctf.py --fetch，来源与结果见real-ctf.md",
  "nodes": [
    {
      "id": "read",
      "plugin": "text.records",
      "config": {
        "path": "../work/real-ctf/input/log/apache2/error.log",
        "start_pattern": "username="
      },
      "inputs": {}
    },
    {
      "id": "password",
      "plugin": "text.extract",
      "config": {
        "field": "内容",
        "pattern": "\\\\xe6[^\\n]*?:\\s(.*?)\\\\n",
        "group": 1,
        "occurrence": "last",
        "output": "password"
      },
      "inputs": {
        "data": "read:data"
      }
    },
    {
      "id": "clean_password",
      "plugin": "text.replace",
      "config": {
        "fields": [
          "password"
        ],
        "search": "[\\\\ ]",
        "replacement": "",
        "regex": true
      },
      "inputs": {
        "data": "password:data"
      }
    },
    {
      "id": "url",
      "plugin": "codec.fields",
      "config": {
        "fields": [
          "内容"
        ],
        "operation": "url_decode"
      },
      "inputs": {
        "data": "clean_password:data"
      }
    },
    {
      "id": "extract_username",
      "plugin": "text.extract",
      "config": {
        "field": "内容",
        "pattern": "(?:^|[ &])username=([^&\\s]*)",
        "output": "username"
      },
      "inputs": {
        "data": "url:valid"
      }
    },
    {
      "id": "extract_name",
      "plugin": "text.extract",
      "config": {
        "field": "内容",
        "pattern": "&name=([^&\\s]*)",
        "output": "name"
      },
      "inputs": {
        "data": "extract_username:data"
      }
    },
    {
      "id": "extract_idcard",
      "plugin": "text.extract",
      "config": {
        "field": "内容",
        "pattern": "&idcard=([^&\\s]*)",
        "output": "idcard"
      },
      "inputs": {
        "data": "extract_name:data"
      }
    },
    {
      "id": "extract_phone",
      "plugin": "text.extract",
      "config": {
        "field": "内容",
        "pattern": "&phone=([^&\\s]*)",
        "output": "phone"
      },
      "inputs": {
        "data": "extract_idcard:data"
      }
    },
    {
      "id": "rules",
      "plugin": "validate.rules",
      "config": {
        "rules": [
          {
            "field": "username",
            "check": "regex",
            "pattern": "[A-Za-z0-9]+"
          },
          {
            "field": "name",
            "check": "regex",
            "pattern": "[\\u4e00-\\u9fff]+"
          },
          {
            "field": "phone",
            "check": "regex",
            "pattern": "(?:734|735|736|737|738|739|747|748|750|751|752|757|758|759|772|778|782|783|784|787|788|795|798|730|731|732|740|745|746|755|756|766|767|771|775|776|785|786|796|733|749|753|773|774|777|780|781|789|790|791|793|799)[0-9]{8}"
          },
          {
            "field": "password",
            "check": "required"
          }
        ]
      },
      "inputs": {
        "data": "extract_phone:data"
      }
    },
    {
      "id": "identity",
      "plugin": "validate.identity",
      "config": {
        "field": "idcard",
        "check_sequence": false,
        "check_date": false,
        "check_region_format": false,
        "allow_lower_x": false
      },
      "inputs": {
        "data": "rules:valid"
      }
    },
    {
      "id": "select",
      "plugin": "columns.select",
      "config": {
        "fields": [
          "username",
          "password",
          "name",
          "idcard",
          "phone"
        ]
      },
      "inputs": {
        "data": "identity:valid"
      }
    },
    {
      "id": "mask_names",
      "plugin": "text.replace",
      "config": {
        "fields": [
          "username",
          "name"
        ],
        "search": "(?<=^.).$|(?<=.).(?=.)",
        "replacement": "*",
        "regex": true
      },
      "inputs": {
        "data": "select:data"
      }
    },
    {
      "id": "mask_id_prefix",
      "plugin": "text.replace",
      "config": {
        "fields": [
          "idcard"
        ],
        "search": "^.{6}",
        "replacement": "******",
        "regex": true
      },
      "inputs": {
        "data": "mask_names:data"
      }
    },
    {
      "id": "mask_id_suffix",
      "plugin": "text.replace",
      "config": {
        "fields": [
          "idcard"
        ],
        "search": ".{8}$",
        "replacement": "********",
        "regex": true
      },
      "inputs": {
        "data": "mask_id_prefix:data"
      }
    },
    {
      "id": "mask_phone",
      "plugin": "text.mask",
      "config": {
        "fields": [
          "phone"
        ],
        "keep_start": 3,
        "keep_end": 4
      },
      "inputs": {
        "data": "mask_id_suffix:data"
      }
    },
    {
      "id": "password_digest",
      "plugin": "codec.fields",
      "config": {
        "fields": [
          "password"
        ],
        "operation": "md5"
      },
      "inputs": {
        "data": "mask_phone:data"
      }
    },
    {
      "id": "serialize",
      "plugin": "table.serialize",
      "config": {
        "fields": [],
        "line_ending": "crlf",
        "trailing_blank_lines": 0
      },
      "inputs": {
        "data": "password_digest:valid"
      }
    },
    {
      "id": "answer",
      "plugin": "text.write",
      "config": {
        "path": "../work/real-ctf/results/log/submission.csv",
        "fields": [
          "提交内容"
        ],
        "raw": true,
        "overwrite": true
      },
      "inputs": {
        "data": "serialize:data"
      }
    },
    {
      "id": "digest",
      "plugin": "codec.fields",
      "config": {
        "fields": [
          "提交内容"
        ],
        "operation": "md5"
      },
      "inputs": {
        "data": "serialize:data"
      }
    },
    {
      "id": "flag",
      "plugin": "text.template",
      "config": {
        "template": "flag{{{提交内容}}}",
        "output": "flag"
      },
      "inputs": {
        "data": "digest:valid"
      }
    },
    {
      "id": "save_flag",
      "plugin": "text.write",
      "config": {
        "path": "../work/real-ctf/results/log/flag.txt",
        "fields": [
          "flag"
        ],
        "overwrite": true
      },
      "inputs": {
        "data": "flag:data"
      }
    }
  ]
}
