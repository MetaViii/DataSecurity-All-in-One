{
  "version": 1,
  "name": "真实题：羊城杯2024：原始CSV列复原",
  "description": "10000行字段错位复原，保留原赛中文表头；原附示例核对通过。",
  "nodes": [
    {
      "id": "read",
      "plugin": "csv.read",
      "config": {
        "path": "../work/contest-round2/input/ycb24_analysis/data.csv"
      },
      "inputs": {}
    },
    {
      "id": "realign",
      "plugin": "columns.realign",
      "config": {
        "rules": {
          "number": "[0-9]{1,5}",
          "username": "[A-Za-z0-9]+",
          "password": "[a-f0-9]{32}",
          "name": "[\\u4e00-\\u9fff]+",
          "gender": "男|女",
          "birth": "[0-9]{8}",
          "id": "[0-9]{17}[0-9Xx]",
          "phone": "(?:734|735|736|737|738|739|747|748|750|751|752|757|758|759|772|778|782|783|784|787|788|795|798|730|731|732|740|745|746|755|756|766|767|771|775|776|785|786|796|733|749|753|773|774|777|780|781|789|790|791|793|799)[0-9]{8}"
        }
      },
      "inputs": {
        "data": "read:data"
      }
    },
    {
      "id": "sort",
      "plugin": "rows.sort",
      "config": {
        "rules": [
          {
            "field": "number",
            "type": "number",
            "direction": "asc"
          }
        ]
      },
      "inputs": {
        "data": "realign:valid"
      }
    },
    {
      "id": "serialize",
      "plugin": "table.serialize",
      "config": {
        "fields": [],
        "line_ending": "crlf",
        "trailing_blank_lines": 0
      },
      "inputs": {
        "data": "sort:data"
      }
    },
    {
      "id": "answer",
      "plugin": "text.write",
      "config": {
        "path": "../work/contest-round2/results/ycb24_analysis/canonical-reference.csv",
        "fields": [
          "提交内容"
        ],
        "raw": true,
        "overwrite": true
      },
      "inputs": {
        "data": "serialize:data"
      }
    },
    {
      "id": "digest",
      "plugin": "codec.fields",
      "config": {
        "fields": [
          "提交内容"
        ],
        "operation": "md5"
      },
      "inputs": {
        "data": "serialize:data"
      }
    },
    {
      "id": "flag",
      "plugin": "text.template",
      "config": {
        "template": "flag{{{提交内容}}}",
        "output": "flag"
      },
      "inputs": {
        "data": "digest:valid"
      }
    },
    {
      "id": "save_flag",
      "plugin": "text.write",
      "config": {
        "path": "../work/contest-round2/results/ycb24_analysis/reuse-reference-flag.txt",
        "fields": [
          "flag"
        ],
        "overwrite": true
      },
      "inputs": {
        "data": "flag:data"
      }
    },
    {
      "id": "submission_columns",
      "plugin": "columns.rename",
      "config": {
        "mapping": {
          "number": "编号",
          "username": "用户名",
          "password": "密码",
          "name": "姓名",
          "gender": "性别",
          "birth": "出生日期",
          "id": "身份证号",
          "phone": "手机号码"
        }
      },
      "inputs": {
        "data": "sort:data"
      }
    },
    {
      "id": "save_submission",
      "plugin": "csv.write",
      "config": {
        "path": "../work/contest-round2/results/ycb24_analysis/submission.csv",
        "line_ending": "crlf",
        "overwrite": true
      },
      "inputs": {
        "data": "submission_columns:data"
      }
    }
  ]
}
